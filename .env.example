# ไฟล์ตัวอย่างสำหรับตั้งค่า Environment Variables
# ให้คัดลอกไฟล์นี้ไปเป็น .env แล้วแก้ไขค่าให้ถูกต้อง
# *** ห้าม push ไฟล์ .env ขึ้น GitHub เด็ดขาด! ***

# ==========================================
# LINE Bot Credentials (จาก LINE Developers Console)
# ==========================================
LINE_CHANNEL_SECRET=ใส่_channel_secret_ของคุณที่นี่
LINE_CHANNEL_ACCESS_TOKEN=ใส่_access_token_ของคุณที่นี่

# (ถ้ามี Secret สำรอง เช่น กรณีกำลัง Migrate Channel)
LINE_CHANNEL_SECRET_FALLBACK=

# ==========================================
# Google Gemini AI
# ==========================================
GEMINI_API_KEY=ใส่_gemini_api_key_ของคุณที่นี่

# เลือก Gemini Model (ถ้าไม่กำหนดจะใช้ gemini-flash-lite-latest)
# ตัวเลือก: gemini-flash-lite-latest | gemini-3.5-flash-lite | gemini-3.1-flash-lite | gemini-3.8-flash | gemini-3.7-flash
GEMINI_MODEL=gemini-flash-lite-latest

# ==========================================
# Admin Dashboard (สำหรับเข้าหน้า /admin)
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ใส่_รหัสผ่าน_admin_ที่ปลอดภัยที่นี่

# LINE User ID ของแอดมิน (สำหรับรับการแจ้งเตือนเมื่อลูกค้าขอคุยกับคน)
# หาได้จาก LINE Developers Console > Messaging API > Send a test message > userId
# หรือเพิ่มบอทเป็นเพื่อน แล้วดู userId ใน webhook log
ADMIN_LINE_USER_ID=ใส่_line_user_id_ของแอดมิน_ที่นี่

# ==========================================
# Server
# ==========================================
PORT=3000

# ==========================================
# System Prompt (ถ้าต้องการ override ค่า default)
# ==========================================
# BOT_SYSTEM_PROMPT=คุณคือแอดมิน AI ประจำร้าน ไม้เทียม Koyo Decor...
