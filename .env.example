# Port สำหรับรัน Webhook Server
PORT=3000

# LINE Messaging API Credentials
# ดูได้จาก LINE Developers Console (https://developers.line.biz/console/)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google Gemini API Key
# รับได้ฟรีจาก Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# โมเดล Gemini ที่ต้องการใช้งาน (แนะนำ: gemini-2.5-flash หรือ gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# System Prompt กำหนดบุคลิกและบทบาทของ AI Bot
BOT_SYSTEM_PROMPT="คุณคือ AI Assistant ประจำ LINE Official Account ที่เป็นมิตร สุภาพ พูดจาไพเราะ ตอบคำถามด้วยภาษาไทยที่เข้าใจง่าย กระชับ และตรงประเด็น หากมีคำถามเกี่ยวกับข้อมูลเฉพาะที่คุณไม่ทราบ ให้แนะนำให้ลูกค้าติดต่อเจ้าหน้าที่โดยตรง"
